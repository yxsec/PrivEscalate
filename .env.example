# Copy this file to .env and fill only the variables required by your model.
# .env is ignored by Git and must never be committed.

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# DeepSeek-compatible provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Generic OpenAI-compatible endpoint used by wintermute/PrivEscAgent.
CPA_API_URL=
CPA_API_KEY=
CPA_API_PATH=/v1/chat/completions

# Per-run override shared by PrivEscAgent and HackSynth.
PRIVESC_API_URL=
PRIVESC_API_KEY=
# Set to anthropic for a native Anthropic endpoint; otherwise use openai.
PRIVESC_PROVIDER=openai

# Optional provider-specific OpenAI-compatible endpoints.
DASHSCOPE_API_URL=
DASHSCOPE_API_KEY=

# Optional path overrides for vendored baselines.
HACKINGBUDDY_SRC=
HACKSYNTH_PATH=
