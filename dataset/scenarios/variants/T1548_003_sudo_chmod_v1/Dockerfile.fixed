FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_chmod (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for chmod has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and sudo (chmod is part of coreutils, already in base)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify chmod is installed
RUN which chmod && ls -la /usr/bin/chmod

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- Vulnerability REMOVED ---
# The sudoers rule for chmod has been removed so testuser cannot run chmod as root
# No /etc/sudoers.d/chmod file is created

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]