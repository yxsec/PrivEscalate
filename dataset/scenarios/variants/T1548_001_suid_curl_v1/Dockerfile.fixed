FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on curl (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: No SUID bit on /usr/bin/curl
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and curl
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Ensure NO SUID bit on curl (default state)
RUN chmod u-s /usr/bin/curl

# Verify vulnerability is NOT in place
RUN ls -la /usr/bin/curl | grep -qv "rws" && echo "No SUID bit on curl - fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]