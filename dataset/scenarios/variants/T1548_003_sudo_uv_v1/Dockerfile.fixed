FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_uv (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for uv has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and dependencies for uv
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Install uv (the Python package manager / runner) via official installer
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    cp /root/.local/bin/uv /usr/bin/uv && \
    chmod 755 /usr/bin/uv

# Verify uv is installed
RUN which uv && ls -la /usr/bin/uv && uv --version

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for uv ---
# The vulnerable sudoers entry has been removed entirely

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]