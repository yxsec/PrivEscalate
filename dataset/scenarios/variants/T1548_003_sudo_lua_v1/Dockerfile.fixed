FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_lua (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for lua has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and Lua
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        lua5.4 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify lua is installed
RUN which lua5.4 && ls -la /usr/bin/lua5.4

# Create a symlink so /usr/bin/lua points to lua5.4
RUN ln -sf /usr/bin/lua5.4 /usr/bin/lua

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for lua ---
# The sudoers.d file for lua is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]