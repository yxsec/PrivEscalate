FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on nasm — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit no longer set on /usr/bin/nasm
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and nasm (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        nasm \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIX: Ensure SUID bit is NOT set on nasm
RUN chmod u-s /usr/bin/nasm

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/nasm && echo "SUID bit confirmed REMOVED from nasm"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]