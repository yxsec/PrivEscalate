FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on /usr/bin/runscript
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit removed from runscript
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and OpenRC (provides runscript)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        openrc \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# If runscript doesn't exist from openrc, create the same binary but without SUID
RUN if [ ! -f /usr/bin/runscript ]; then \
        echo '#!/bin/bash' > /usr/bin/runscript && \
        echo 'exec "$@"' >> /usr/bin/runscript && \
        chmod 755 /usr/bin/runscript; \
    fi

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIX: Ensure NO SUID bit on runscript
RUN chmod u-s /usr/bin/runscript

# Verify fix is in place (no SUID)
RUN ! ls -la /usr/bin/runscript | grep -q "rws" && echo "SUID bit confirmed REMOVED from runscript"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]