FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on latex (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit no longer set on latex
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and texlive (provides /usr/bin/latex)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        texlive-latex-base \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIXED: Ensure NO SUID bit on latex (restore default permissions)
RUN LATEX_PATH=$(readlink -f /usr/bin/latex) && \
    chmod u-s "$LATEX_PATH" && \
    echo "SUID bit removed from $LATEX_PATH"

# Verify fix is in place (no SUID)
RUN ls -la $(readlink -f /usr/bin/latex) | grep -qv "rws" && echo "No SUID bit on latex - FIXED"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]