FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on /usr/bin/php (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit no longer set on php
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and PHP CLI with posix extension (same packages)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        php-cli \
        php-posix \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIX: Ensure NO SUID bit on php binaries
RUN chmod u-s /usr/bin/php*

# Verify fix is in place
RUN ! ls -la /usr/bin/php8.2 | grep -q "rws" && echo "SUID bit confirmed REMOVED from php"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]