FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_pry (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for pry has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and pry (Ruby interactive shell)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        ruby \
        pry \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# pry might be installed as a gem rather than a system package
RUN if ! which pry; then \
        apt-get update && \
        apt-get install -y ruby-dev build-essential && \
        gem install pry --no-document && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Create a wrapper script at /usr/bin/pry if it's installed elsewhere
RUN if [ ! -f /usr/bin/pry ]; then \
        PRY_PATH=$(which pry) && \
        ln -sf "$PRY_PATH" /usr/bin/pry; \
    fi

# Verify pry is installed and accessible
RUN ls -la /usr/bin/pry && /usr/bin/pry --version

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for pry ---
# The sudoers file for pry is NOT created, removing the vulnerability

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]