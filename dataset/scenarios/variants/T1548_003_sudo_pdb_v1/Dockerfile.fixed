FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_pdb (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for pdb has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and python3 (which provides pdb)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# pdb is typically installed as a Python module script; ensure /usr/bin/pdb3 or /usr/bin/pdb exists
RUN if [ ! -f /usr/bin/pdb ]; then ln -s /usr/bin/pdb3 /usr/bin/pdb; fi && \
    ls -la /usr/bin/pdb

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for pdb ---
# The sudoers.d file for pdb is NOT created, removing the privilege escalation vector.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]