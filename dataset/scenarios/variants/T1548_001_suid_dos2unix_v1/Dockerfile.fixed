FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on dos2unix
# ATT&CK: T1548.001 | CWE: CWE-250
# The SUID bit has been removed; dos2unix runs as normal user
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and dos2unix
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        dos2unix \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Ensure dos2unix does NOT have SUID bit (explicit removal)
RUN chmod u-s /usr/bin/dos2unix

# Verify vulnerability is NOT present
RUN ls -la /usr/bin/dos2unix | grep -qv "rws" && echo "No SUID bit on dos2unix — fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]