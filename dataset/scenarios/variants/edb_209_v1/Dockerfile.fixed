FROM debian:bookworm-slim

# ============================================================
# FIXED: SUID removed from /bin/su, preventing privilege escalation
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, build tools, and utilities (same as vulnerable)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        login \
        util-linux \
        gcc \
        binutils \
        gettext \
        locales \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Generate some locales
RUN sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && \
    locale-gen

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIX: Remove SUID bit from /bin/su to prevent privilege escalation
RUN chmod u-s /bin/su 2>/dev/null || true ; \
    chmod u-s /usr/bin/su 2>/dev/null || true

# Still set root password (but without SUID su, testuser cannot use su)
RUN echo "root:r00tCh@ng3d" | chpasswd

# Place the exploit source in the testuser user's home for reference
RUN echo '#!/bin/sh\n# CVE-2000-0844 style escalation via SUID /bin/su\n# FIXED: SUID removed, this will fail\nexec /bin/su -c "/bin/sh" root' > /home/testuser/exploit.sh && \
    chmod +x /home/testuser/exploit.sh && \
    chown testuser:testuser /home/testuser/exploit.sh

# Verify fix is in place
RUN ls -la /bin/su | grep -qv "rws" && echo "SUID bit removed from /bin/su" || true

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]