FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on unsquashfs (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/unsquashfs
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and squashfs-tools (provides unsquashfs and mksquashfs)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        squashfs-tools \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Create a crafted squashfs image containing a SUID root shell
# Same setup as vulnerable version, but without the SUID on unsquashfs
# the extraction won't preserve SUID bits
RUN mkdir -p /tmp/payload && \
    cp /bin/sh /tmp/payload/sh && \
    chmod u+s /tmp/payload/sh && \
    chown root:root /tmp/payload/sh && \
    mksquashfs /tmp/payload /home/testuser/payload.sqfs -noappend -quiet && \
    chown testuser:testuser /home/testuser/payload.sqfs && \
    rm -rf /tmp/payload

# FIXED: Ensure NO SUID bit on unsquashfs
RUN chmod u-s /usr/bin/unsquashfs

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/unsquashfs && echo "SUID bit confirmed REMOVED from unsquashfs"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]