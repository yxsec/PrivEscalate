FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Expert-authored Scenario: expert_ld_preload_sudo_v1 (FIXED)
# Differential baseline: same environment, LD_PRELOAD stripped by sudo.
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        sudo \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# --- PrivEscalate: harden base image ---
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIXED: sudo rule retained, but env_keep for LD_PRELOAD removed.
# Default sudo behaviour strips LD_PRELOAD/LD_LIBRARY_PATH, so
# preloading a malicious shared object no longer elevates.
RUN printf 'testuser ALL=(ALL) NOPASSWD: /usr/bin/id\n' > /etc/sudoers.d/testuser-id && \
    chmod 440 /etc/sudoers.d/testuser-id

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
