FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_lwp-download (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo misconfiguration no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and lwp-download (part of libwww-perl)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        libwww-perl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify lwp-download is installed
RUN which lwp-download && ls -la /usr/bin/lwp-download

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for lwp-download ---
# The sudoers.d file is NOT created, so testuser cannot run lwp-download as root

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]