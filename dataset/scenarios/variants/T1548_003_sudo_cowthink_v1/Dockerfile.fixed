FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_cowthink (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for cowthink no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and cowsay (which includes cowthink)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        cowsay \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# cowsay package installs binaries under /usr/games; create symlink so /usr/bin/cowthink exists
RUN ln -sf /usr/games/cowthink /usr/bin/cowthink

# Verify cowthink is installed and accessible
RUN which cowthink && ls -la /usr/bin/cowthink

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for cowthink ---
# The sudoers entry has been removed so testuser cannot run cowthink as root

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]