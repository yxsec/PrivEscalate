FROM debian:bookworm-slim

# ============================================================
# FIXED version: sudo chmod/cp privilege removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and coreutils (same packages as vulnerable)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify chmod is installed
RUN which chmod && ls -la /bin/chmod

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudoers entry for chmod or cp ---
# The vulnerable sudoers.d/accellion file is NOT created.
# testuser has no sudo privileges at all.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo (standard)
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]