FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on rpm/rpmverify
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit removed from rpmverify/rpm
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and rpm (provides rpmverify/rpm --verify)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        rpm \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Create rpmverify symlink if needed (same as vulnerable, keep packages identical)
RUN if [ ! -f /usr/bin/rpmverify ]; then \
        ln -s /usr/bin/rpm /usr/bin/rpmverify; \
    fi

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIXED: Ensure NO SUID bit on rpm or rpmverify
RUN chmod u-s /usr/bin/rpm && \
    chmod u-s /usr/bin/rpmverify 2>/dev/null || true

# Verify fix is in place (no SUID)
RUN ls -la /usr/bin/rpm | grep -qv "rws" && echo "SUID bit NOT set on rpm (fixed)"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]