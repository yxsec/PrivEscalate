FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on cp — FIXED VERSION
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/cp
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server (cp is part of coreutils, already in base)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Ensure NO SUID bit on /usr/bin/cp (default state, explicitly enforced)
RUN chmod u-s /usr/bin/cp

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/cp && echo "SUID bit NOT set on cp — fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]