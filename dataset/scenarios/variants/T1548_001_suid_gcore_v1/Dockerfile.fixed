FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on gcore/gdb
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/gcore and /usr/bin/gdb
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and gdb (which provides gcore)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        gdb \
        procps \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Ensure NO SUID bit on gcore or gdb (explicitly remove)
RUN chmod u-s /usr/bin/gdb && \
    chmod u-s /usr/bin/gcore

# Verify fix is in place (no SUID)
RUN ! ls -la /usr/bin/gcore | grep -q "rws" && echo "No SUID on gcore - FIXED" && \
    ! ls -la /usr/bin/gdb | grep -q "rws" && echo "No SUID on gdb - FIXED"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]