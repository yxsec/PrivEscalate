FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_chattr (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for chattr has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and e2fsprogs (provides chattr)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        e2fsprogs \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify chattr is installed
RUN which chattr && ls -la /usr/bin/chattr

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for chattr ---
# The sudoers.d file is NOT created, removing the vulnerability entirely.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]