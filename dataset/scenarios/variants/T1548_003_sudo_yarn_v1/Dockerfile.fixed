FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_yarn (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for yarn has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and yarn (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        yarnpkg \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Create symlink so /usr/bin/yarn exists (Debian ships it as yarnpkg)
RUN ln -sf /usr/bin/yarnpkg /usr/bin/yarn

# Verify yarn is installed
RUN which yarn && ls -la /usr/bin/yarn

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for yarn ---
# The sudoers entry has been removed so testuser cannot run yarn as root

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]