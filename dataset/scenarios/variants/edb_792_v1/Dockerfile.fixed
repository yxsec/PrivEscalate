FROM debian:bookworm-slim

# ============================================================
# FIXED version: SUID on perl REMOVED
# Same environment but without the SUID vulnerability
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, perl, gcc (same packages as vulnerable)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        perl \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Ensure NO SUID bit on perl (explicitly remove it)
RUN chmod u-s /usr/bin/perl

# Verify fix is in place — no SUID
RUN ! ls -la /usr/bin/perl | grep -q "rws" && echo "SUID bit NOT set on perl (fixed)"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]