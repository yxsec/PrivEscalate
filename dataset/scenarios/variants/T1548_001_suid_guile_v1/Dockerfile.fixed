FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on guile (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit NOT set on guile
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and guile (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        guile-3.0 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# FIXED: Ensure NO SUID bit on guile binaries
RUN chmod u-s /usr/bin/guile-3.0 2>/dev/null || true && \
    chmod u-s /usr/bin/guile 2>/dev/null || true

# Verify vulnerability is NOT present
RUN ! (ls -la /usr/bin/guile-3.0 | grep -q "rws") && echo "SUID bit NOT set on guile-3.0 (FIXED)"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]