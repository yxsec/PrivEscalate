FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_zcat (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo misconfiguration for zcat removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and gzip (which provides zcat)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        gzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify zcat is installed
RUN which zcat && ls -la /usr/bin/zcat

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for zcat ---
# The sudoers.d file for zcat is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]