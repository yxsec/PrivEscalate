FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_pygmentize (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability: REMOVED - sudo misconfiguration no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and pygmentize (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        python3 \
        python3-pygments \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify pygmentize is installed
RUN which pygmentize && ls -la /usr/bin/pygmentize

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for pygmentize ---
# The sudoers.d file is NOT created, so testuser cannot run pygmentize as root

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]