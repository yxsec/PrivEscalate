FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on chmod — FIXED VERSION
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit is NOT set on /usr/bin/chmod
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server (chmod is part of coreutils, already present)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# Ensure chmod does NOT have SUID bit (explicit removal)
RUN chmod u-s /usr/bin/chmod

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/chmod && echo "SUID bit NOT set on chmod — fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]