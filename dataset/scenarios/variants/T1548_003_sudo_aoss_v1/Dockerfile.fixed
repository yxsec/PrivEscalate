FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_aoss (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for aoss no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and alsa-oss (which provides aoss)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        alsa-oss \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify aoss is installed
RUN which aoss && ls -la /usr/bin/aoss

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- NO sudo vulnerability ---
# The sudoers rule for aoss has been removed entirely

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]