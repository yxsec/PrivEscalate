FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_bundle (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for bundle has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and ruby-bundler (which provides /usr/bin/bundle)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        ruby \
        bundler \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify bundle is installed
RUN which bundle && ls -la /usr/bin/bundle

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for bundle ---
# The sudoers.d file for bundle is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]