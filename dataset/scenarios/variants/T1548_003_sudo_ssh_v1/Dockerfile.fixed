FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_ssh (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for ssh has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server (both client and server), sudo
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        openssh-client \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify ssh client is installed
RUN which ssh && ls -la /usr/bin/ssh

# Create low-privilege user
RUN useradd -m -s /bin/bash testuser && \
    echo "testuser:t3stP@ss" | chpasswd

# --- FIXED: No sudo rule for ssh ---
# The sudoers.d file for ssh is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH server - allow password auth and root login
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:r00tCh@ng3d" | chpasswd

# Generate host keys so sshd can start and ssh client can connect to localhost
RUN ssh-keygen -A

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]