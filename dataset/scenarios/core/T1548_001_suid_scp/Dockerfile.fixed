FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on scp — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/scp
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and openssh-client (provides scp)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIX: Ensure SUID bit is NOT set on scp (restore default permissions)
RUN chmod u-s /usr/bin/scp

# Verify fix is in place
RUN ls -la /usr/bin/scp | grep -qv "rws" && echo "SUID bit NOT set on scp — fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]