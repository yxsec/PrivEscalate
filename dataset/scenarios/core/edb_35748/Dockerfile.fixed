FROM debian:bookworm-slim

# Install required packages
RUN apt-get update && apt-get install -y \
    openssh-server \
    passwd \
    && rm -rf /var/lib/apt/lists/*

# Setup SSH
RUN mkdir -p /var/run/sshd && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo 'lowpriv:password123' | chpasswd

# Create the rc.d directory structure but with PROPER permissions (fixed)
RUN mkdir -p /etc/rc.d && \
    echo '#!/bin/bash' > /etc/rc.d/rc.sysinit && \
    echo '# Red Star 2.0 rc.sysinit - system initialization script (FIXED)' >> /etc/rc.d/rc.sysinit && \
    chmod 0755 /etc/rc.d/rc.sysinit && \
    chown root:root /etc/rc.d/rc.sysinit

# FIXED: /etc/passwd has proper permissions - not world-writeable
RUN chmod 0644 /etc/passwd && \
    chown root:root /etc/passwd

# Keep the exploit script for testing (it should fail)
RUN cat <<'EXPLOIT_EOF' > /home/lowpriv/exploit.sh
#!/bin/bash
# Red Star 2.0 Local Privilege Escalation (OSVDB-116453)
# Exploits world-writeable system files to add a root-level user

echo "[*] Red Star 2.0 - World-writeable file privilege escalation"
echo "[*] Checking /etc/rc.d/rc.sysinit permissions..."
ls -la /etc/rc.d/rc.sysinit
echo "[*] Checking /etc/passwd permissions..."
ls -la /etc/passwd

echo "[*] Attempting to add passwordless root user 'r00t' to /etc/passwd..."
/bin/echo "r00t::0:0::/tmp:/bin/bash" >> /etc/passwd

if grep -q "r00t" /etc/passwd; then
    echo "[+] Done! Now run: su - r00t"
else
    echo "[-] FAILED: Cannot write to /etc/passwd (properly secured)"
fi
EXPLOIT_EOF

RUN chown lowpriv:lowpriv /home/lowpriv/exploit.sh && \
    chmod +x /home/lowpriv/exploit.sh

# Verify the fix is in place
RUN ls -la /etc/rc.d/rc.sysinit && \
    ls -la /etc/passwd && \
    test "$(stat -c '%a' /etc/passwd)" = "644" && \
    echo "FIX CONFIRMED: /etc/passwd has proper permissions (644)" && \
    test "$(stat -c '%a' /etc/rc.d/rc.sysinit)" = "755" && \
    echo "FIX CONFIRMED: /etc/rc.d/rc.sysinit has proper permissions (755)"

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]