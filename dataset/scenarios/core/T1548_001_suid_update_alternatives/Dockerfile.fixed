FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on update-alternatives (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# FIXED: SUID bit removed from /usr/bin/update-alternatives
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server (update-alternatives is part of dpkg which is always present)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure NO SUID bit on update-alternatives (default state)
RUN chmod u-s /usr/bin/update-alternatives

# Verify vulnerability is NOT in place
RUN ls -la /usr/bin/update-alternatives | grep -qv "rws" && echo "No SUID bit on update-alternatives (FIXED)"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]