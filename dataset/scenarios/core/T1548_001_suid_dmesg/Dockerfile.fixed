FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on dmesg
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit NOT set on /usr/bin/dmesg
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and util-linux (provides dmesg)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure dmesg does NOT have SUID bit (explicitly remove it)
RUN chmod u-s /usr/bin/dmesg

# Make sure 'less' is available as the default pager (same packages as vulnerable)
RUN apt-get update && \
    apt-get install -y --no-install-recommends less && \
    rm -rf /var/lib/apt/lists/*

# Verify vulnerability is NOT in place
RUN ls -la /usr/bin/dmesg | grep -qv "rws" && echo "No SUID bit on dmesg - FIXED"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]