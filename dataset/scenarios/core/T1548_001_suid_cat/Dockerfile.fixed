FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on cat — FIXED VERSION
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/cat
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server (cat is part of coreutils, already in base image)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure NO SUID bit on /usr/bin/cat (default state, explicitly enforced)
RUN chmod u-s /usr/bin/cat

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/cat && echo "SUID bit NOT set on cat — fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]