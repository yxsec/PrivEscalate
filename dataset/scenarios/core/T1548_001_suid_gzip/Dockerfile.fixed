FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on gzip — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/gzip
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and gzip (gzip is usually present but ensure it)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        gzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure SUID bit is NOT set on /usr/bin/gzip (fix the vulnerability)
RUN chmod u-s /usr/bin/gzip

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/gzip && echo "SUID bit confirmed removed from gzip"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]