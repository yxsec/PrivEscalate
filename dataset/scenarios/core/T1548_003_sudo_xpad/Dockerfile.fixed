FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_xpad (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability: REMOVED - sudo misconfiguration no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and xpad (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        xpad \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify xpad is installed
RUN which xpad && ls -la /usr/bin/xpad

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for xpad ---
# The sudoers entry for xpad has been removed entirely
# Ensure no leftover sudoers fragment exists
RUN rm -f /etc/sudoers.d/xpad

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]