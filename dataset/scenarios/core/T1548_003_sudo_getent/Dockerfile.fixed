FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_getent (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for getent has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and getent (part of libc-bin, already present but be explicit)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        libc-bin \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify getent is installed
RUN which getent && ls -la /usr/bin/getent

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for getent ---
# The sudoers.d file for getent is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]