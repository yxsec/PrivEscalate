FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_setfacl (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for setfacl has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and acl (provides setfacl)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        acl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify setfacl is installed
RUN which setfacl && ls -la /usr/bin/setfacl

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for setfacl ---
# The sudoers.d file is NOT created, removing the vulnerability entirely.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]