FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_telnet (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for telnet has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and telnet client (same packages as vulnerable)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        telnet \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify telnet is installed
RUN which telnet && ls -la /usr/bin/telnet

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for telnet ---
# The sudoers.d file is NOT created, so lowpriv cannot run telnet as root

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]