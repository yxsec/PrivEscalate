FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on rpmquery (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit removed from rpmquery/rpm
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and rpm (provides rpmquery)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        rpm \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIXED: Ensure NO SUID bit on rpmquery or rpm
RUN RPMQUERY_PATH=$(which rpmquery 2>/dev/null || echo "/usr/bin/rpmquery") && \
    REAL_PATH=$(readlink -f "$RPMQUERY_PATH") && \
    chmod u-s "$REAL_PATH" && \
    chmod u-s /usr/bin/rpm 2>/dev/null || true && \
    chmod u-s /usr/bin/rpmquery 2>/dev/null || true

# Verify fix is in place (no SUID)
RUN ls -la $(readlink -f /usr/bin/rpmquery) | grep -qv "rws" && \
    echo "SUID bit confirmed REMOVED from rpmquery"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]