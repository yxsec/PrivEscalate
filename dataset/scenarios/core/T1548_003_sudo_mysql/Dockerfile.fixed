FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_mysql (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for mysql has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and MySQL client (same packages as vulnerable)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        default-mysql-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify mysql client is installed
RUN which mysql && ls -la /usr/bin/mysql

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for mysql ---
# The sudoers.d file for mysql is NOT created, so lowpriv cannot run mysql as root.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]