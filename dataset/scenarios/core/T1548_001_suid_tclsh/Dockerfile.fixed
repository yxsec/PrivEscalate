FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on tclsh (FIXED)
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit NOT set on tclsh
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and tcl (provides tclsh) — same packages as vulnerable version
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        tcl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIXED: Ensure SUID bit is NOT set on tclsh
RUN TCLSH_REAL=$(readlink -f /usr/bin/tclsh) && \
    chmod u-s "$TCLSH_REAL" && \
    echo "SUID bit removed from $TCLSH_REAL"

# Verify fix is in place (no SUID)
RUN TCLSH_REAL=$(readlink -f /usr/bin/tclsh) && \
    ! ls -la "$TCLSH_REAL" | grep -q "rws" && echo "Confirmed: no SUID bit on tclsh"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]