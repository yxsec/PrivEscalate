FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on Perl — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/perl
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and perl (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        perl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIXED: Ensure NO SUID bit on perl (explicitly remove it)
RUN chmod u-s /usr/bin/perl

# Verify fix is in place — SUID bit must NOT be set
RUN ! ls -la /usr/bin/perl | grep -q "rws" && echo "SUID bit confirmed REMOVED from perl"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]