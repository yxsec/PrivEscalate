FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_doas (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for doas removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and doas (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        doas \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify doas is installed
RUN which doas && ls -la /usr/bin/doas

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Keep doas.conf the same (it's not the vulnerability itself)
RUN echo "permit nopass root" > /etc/doas.conf && \
    chmod 400 /etc/doas.conf

# --- FIXED: Do NOT grant sudo access to doas ---
# The sudoers.d/doas file is intentionally NOT created.
# Without the sudo rule, lowpriv cannot run doas as root.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]