FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on setcap — FIXED VERSION
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from setcap
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, libcap2-bin (provides setcap/getcap), and python3
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        libcap2-bin \
        python3 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIX: Ensure setcap does NOT have SUID bit (restore default permissions)
RUN chmod u-s /usr/sbin/setcap

# Verify fix is in place (no SUID)
RUN test ! -u /usr/sbin/setcap && echo "SUID bit confirmed REMOVED from setcap"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]