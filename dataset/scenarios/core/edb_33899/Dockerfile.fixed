FROM debian:bookworm-slim

# Install required packages
RUN apt-get update && apt-get install -y \
    openssh-server \
    cron \
    net-tools \
    wget \
    build-essential \
    passwd \
    && rm -rf /var/lib/apt/lists/*

# Setup SSH
RUN mkdir -p /var/run/sshd && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo 'lowpriv:password123' | chpasswd

# Install PATCHED chkrootkit with the fix applied (quoted variable assignment)
RUN mkdir -p /usr/local/chkrootkit && \
    cat <<'CHKROOTKIT_EOF' > /usr/local/chkrootkit/chkrootkit
#!/bin/bash
# Patched chkrootkit - CVE-2014-0476 fixed
# Fix: proper quoting around variable assignment in slapper()

ROOTDIR="/"
SYSTEM="Linux"
QUIET=""
NOT_INFECTED=0

netstat=$(which netstat 2>/dev/null || echo "netstat")
egrep=$(which egrep 2>/dev/null || echo "egrep")
awk=$(which awk 2>/dev/null || echo "awk")

slapper () {
   SLAPPER_FILES="${ROOTDIR}tmp/.bugtraq ${ROOTDIR}tmp/.bugtraq.c"
   SLAPPER_FILES="$SLAPPER_FILES ${ROOTDIR}tmp/.unlock ${ROOTDIR}tmp/httpd \
   ${ROOTDIR}tmp/update ${ROOTDIR}tmp/.cinik ${ROOTDIR}tmp/.b"
   SLAPPER_PORT="0.0:2002 |0.0:4156 |0.0:1978 |0.0:1812 |0.0:2015 "
   OPT=-an
   STATUS=0
   file_port=

   if ${netstat} "${OPT}" 2>/dev/null | ${egrep} "^tcp" 2>/dev/null | ${egrep} "${SLAPPER_PORT}" > /dev/null 2>&1
      then
      STATUS=1
      [ "$SYSTEM" = "Linux" ] && file_port=$($netstat -p ${OPT} 2>/dev/null | \
         $egrep "^tcp" 2>/dev/null | $egrep "${SLAPPER_PORT}" 2>/dev/null | ${awk} '{ print  $7 }' | tr -d :)
   fi
   for i in ${SLAPPER_FILES}; do
      if [ -f ${i} ]; then
         # FIXED: proper quoting prevents execution of $i
         file_port="$file_port $i"
         STATUS=1
      fi
   done
   if [ ${STATUS} -eq 1 ] ;then
      echo "Warning: Possible Slapper Worm installed ($file_port)"
   else
      if [ "${QUIET}" != "t" ]; then echo "not infected"; fi
         return ${NOT_INFECTED}
   fi
}

echo "ROOTDIR is \`${ROOTDIR}'"
echo "Checking \`slapper'..."
slapper
echo "chkrootkit scan complete."
CHKROOTKIT_EOF

RUN chmod 755 /usr/local/chkrootkit/chkrootkit && \
    ln -sf /usr/local/chkrootkit/chkrootkit /usr/local/bin/chkrootkit

# Set up a cron job to run chkrootkit as root every minute (same as vulnerable version)
RUN echo "* * * * * root /usr/local/bin/chkrootkit > /dev/null 2>&1" > /etc/cron.d/chkrootkit_check && \
    chmod 644 /etc/cron.d/chkrootkit_check

# Make /tmp world-writable (as it normally is)
RUN chmod 1777 /tmp

# Create exploit helper script for the low-priv user (same as vulnerable version)
RUN cat <<'EXPLOIT_EOF' > /home/lowpriv/exploit.sh
#!/bin/bash
# CVE-2014-0476 - chkrootkit 0.49 Local Privilege Escalation
# This exploit should FAIL on the patched version

echo "[*] CVE-2014-0476 chkrootkit 0.49 local root exploit"
echo "[*] Creating malicious /tmp/update..."

cat > /tmp/update <<'PAYLOAD'
#!/bin/bash
cp /bin/bash /tmp/rootshell
chmod 4755 /tmp/rootshell
chown root:root /tmp/rootshell
PAYLOAD

chmod +x /tmp/update

echo "[+] /tmp/update created and made executable"
echo "[*] Waiting for chkrootkit cron job to execute (runs every minute)..."
echo "[*] On the patched version, /tmp/rootshell should NOT be created."
EXPLOIT_EOF

RUN chown lowpriv:lowpriv /home/lowpriv/exploit.sh && \
    chmod +x /home/lowpriv/exploit.sh

# Verify the fix is in place
RUN echo "=== Verifying patched chkrootkit ===" && \
    grep -n 'file_port="$file_port $i"' /usr/local/chkrootkit/chkrootkit && \
    echo "Patched line confirmed (proper quoting)" && \
    ls -la /usr/local/bin/chkrootkit

EXPOSE 22
CMD service cron start && /usr/sbin/sshd -D