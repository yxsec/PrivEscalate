FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_dvips (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for dvips no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and dvips (part of texlive-binaries)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        texlive-binaries \
        texlive-latex-base \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify dvips is installed
RUN which dvips && ls -la /usr/bin/dvips

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Create a minimal .dvi file (same as vulnerable image for consistency)
RUN cd /home/lowpriv && \
    echo '\\documentclass{article}\\begin{document}Hello\\end{document}' > texput.tex && \
    latex texput.tex && \
    chown lowpriv:lowpriv texput.* && \
    ls -la texput.dvi

# --- FIXED: No sudo rule for dvips ---
# The sudoers.d entry for dvips is NOT created, so lowpriv cannot run dvips as root.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]