FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on busctl — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit no longer set on busctl
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and systemd (provides busctl)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        systemd \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure busctl does NOT have SUID bit (default permissions)
RUN chmod u-s /usr/bin/busctl

# Verify vulnerability is NOT in place
RUN ! ls -la /usr/bin/busctl | grep -q "rws" && echo "SUID bit confirmed NOT set on busctl"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]