FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on /usr/bin/R — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# The SUID bit has been removed; R runs as normal user.
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and R (r-base-core provides /usr/bin/R)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        r-base-core \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIXED: Ensure NO SUID bit on R or any of its components
RUN chmod u-s /usr/bin/R && \
    chmod u-s /usr/lib/R/bin/R 2>/dev/null || true && \
    chmod u-s /usr/lib/R/bin/exec/R 2>/dev/null || true && \
    chmod u-s /usr/bin/Rscript 2>/dev/null || true

# Verify fix is in place (no SUID)
RUN ! (ls -la /usr/bin/R | grep -q "rws") && echo "SUID bit confirmed REMOVED from /usr/bin/R"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]