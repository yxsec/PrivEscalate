FROM debian:bookworm-slim

# Install required packages
RUN apt-get update && apt-get install -y \
    openssh-server \
    cron \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Setup SSH
RUN mkdir -p /run/sshd && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config

# Create a shared group
RUN groupadd -g 1000 users_shared

# Create victim and low-priv users
RUN useradd -m -s /bin/bash -g users_shared victim && \
    useradd -m -s /bin/bash -g users_shared lowpriv && \
    echo 'lowpriv:password123' | chpasswd && \
    echo 'victim:victimpass' | chpasswd

# Simulate RealPlayer 9 installation for the victim user
# FIX: Config files are NOT group-writable (chmod 700/600 instead of 770/660)
RUN mkdir -p /home/victim/.realnetworks/RealShared_0_0 && \
    mkdir -p /home/victim/Real/Codecs && \
    echo 'dt_codecs=/home/victim/Real/Codecs' > /home/victim/.realnetworks/RealShared_0_0/config && \
    echo '# RealPlayer 9 configuration' >> /home/victim/.realnetworks/RealShared_0_0/config && \
    touch /home/victim/Real/Codecs/cook.so.6.0 && \
    chown -R victim:users_shared /home/victim/.realnetworks /home/victim/Real && \
    chmod 750 /home/victim && \
    chmod -R 700 /home/victim/.realnetworks && \
    chmod 600 /home/victim/.realnetworks/RealShared_0_0/config

# Create the realplay wrapper but WITHOUT SUID - runs as calling user only
RUN cat > /usr/local/bin/realplay <<'SCRIPT'
#!/bin/bash
# Simulated RealPlayer 9 launcher - reads config and loads codecs
CONFIG="/home/victim/.realnetworks/RealShared_0_0/config"
if [ -f "$CONFIG" ]; then
    CODECS_PATH=$(grep '^dt_codecs=' "$CONFIG" | cut -d= -f2)
    if [ -n "$CODECS_PATH" ] && [ -f "$CODECS_PATH/cook.so.6.0" ]; then
        /bin/bash "$CODECS_PATH/cook.so.6.0" 2>/dev/null
    fi
fi
SCRIPT
RUN chmod 0755 /usr/local/bin/realplay && \
    chown root:root /usr/local/bin/realplay

# Cron job still present but realplay is not SUID
RUN echo '* * * * * root /usr/local/bin/realplay >> /tmp/realplay.log 2>&1' > /etc/cron.d/realplayer && \
    chmod 644 /etc/cron.d/realplayer

# Verify the fix is in place
RUN echo "=== Fix Verification ===" && \
    ls -la /home/victim/.realnetworks/RealShared_0_0/config && \
    echo "Config file is owner-only (mode 600) - FIXED" && \
    ls -la /usr/local/bin/realplay && \
    echo "realplay has no SUID bit - FIXED"

# Create startup script
RUN echo '#!/bin/bash\ncron\nexec /usr/sbin/sshd -D' > /start.sh && \
    chmod +x /start.sh

EXPOSE 22
CMD ["/bin/bash", "/start.sh"]