FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_check_by_ssh (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for check_by_ssh removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and monitoring-plugins (which provides check_by_ssh)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        monitoring-plugins-basic \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Create symlink same as vulnerable version
RUN if [ -f /usr/lib/nagios/plugins/check_by_ssh ]; then \
        ln -sf /usr/lib/nagios/plugins/check_by_ssh /usr/bin/check_by_ssh; \
    fi

# Verify check_by_ssh is available
RUN ls -la /usr/bin/check_by_ssh && /usr/bin/check_by_ssh --help || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for check_by_ssh ---
# The sudoers.d file is NOT created, removing the privilege escalation vector.

# Set up root SSH key (same as vulnerable for identical environment)
RUN ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" -q && \
    cat /root/.ssh/id_ed25519.pub >> /root/.ssh/authorized_keys && \
    chmod 600 /root/.ssh/authorized_keys

RUN mkdir -p /etc/ssh && \
    ssh-keygen -A && \
    ssh-keyscan -H 127.0.0.1 >> /root/.ssh/known_hosts 2>/dev/null; \
    ssh-keyscan -H localhost >> /root/.ssh/known_hosts 2>/dev/null; \
    true

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]