FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on setlock
# ATT&CK: T1548.001 | CWE: CWE-250
# Vulnerability REMOVED: SUID bit NOT set on setlock
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and daemontools (provides setlock)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        daemontools \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# setlock may be installed in /usr/bin or elsewhere depending on package
RUN if [ ! -f /usr/bin/setlock ]; then \
        SETLOCK_PATH=$(find / -name setlock -type f 2>/dev/null | head -1) && \
        if [ -n "$SETLOCK_PATH" ]; then \
            cp "$SETLOCK_PATH" /usr/bin/setlock; \
        fi; \
    fi

# FIXED: Ensure NO SUID bit on setlock
RUN chmod u-s /usr/bin/setlock

# Verify fix is in place (no SUID)
RUN ls -la /usr/bin/setlock | grep -qv "rws" && echo "SUID bit NOT set on setlock (fixed)"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]