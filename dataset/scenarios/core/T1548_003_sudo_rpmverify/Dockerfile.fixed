FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_rpmverify (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for rpmverify no longer present
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and rpm tools (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        rpm \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Same symlink setup as vulnerable version to keep environment identical
RUN if [ ! -f /usr/bin/rpmverify ]; then \
        ln -s /usr/bin/rpm /usr/bin/rpmverify; \
    fi && \
    ls -la /usr/bin/rpmverify && \
    ls -la /usr/bin/rpm

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for rpmverify ---
# The sudoers.d file is NOT created, removing the vulnerability entirely.

# Verify sudo configuration is valid
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]