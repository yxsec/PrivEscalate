FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_cpio (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for cpio has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and cpio (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        cpio \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify cpio is installed
RUN which cpio && ls -la /usr/bin/cpio

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for cpio ---
# The sudoers.d entry for cpio is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]