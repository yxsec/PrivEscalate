FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on look — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/look
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and bsdutils/util-linux (provides /usr/bin/look)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        bsdutils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Ensure look is available (it's part of bsdextrautils in bookworm)
RUN apt-get update && \
    apt-get install -y --no-install-recommends bsdextrautils && \
    rm -rf /var/lib/apt/lists/*

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIX: Ensure SUID bit is NOT set on /usr/bin/look
RUN chmod u-s /usr/bin/look

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/look && echo "SUID bit confirmed REMOVED from look"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]