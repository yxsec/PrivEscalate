FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on aria2c — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/aria2c
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and aria2 (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        aria2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIX: Ensure NO SUID bit on aria2c (explicitly remove it)
RUN chmod u-s /usr/bin/aria2c

# Verify fix is in place
RUN ls -la /usr/bin/aria2c | grep -qv "rws" && echo "SUID bit NOT set on aria2c — fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]