FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: FIXED — no SUID on pidstat
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/pidstat
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and sysstat (provides pidstat)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        sysstat \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure NO SUID bit on pidstat (explicitly remove it)
RUN chmod u-s /usr/bin/pidstat

# Verify fix is in place (no SUID)
RUN test ! -u /usr/bin/pidstat && echo "SUID bit confirmed REMOVED from pidstat"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]