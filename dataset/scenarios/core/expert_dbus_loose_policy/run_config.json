{
  "docker_run_args": [
    "--privileged",
    "--cgroupns=host",
    "--tmpfs", "/tmp",
    "--tmpfs", "/run",
    "-v", "/sys/fs/cgroup:/sys/fs/cgroup:rw"
  ],
  "requires_privileged": true,
  "startup_delay": 12,
  "note": "D-Bus + systemd require --privileged with cgroupns=host and cgroup rw mount."
}
