FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: SUID on /usr/bin/ex — FIXED
# ATT&CK: T1548.001 | CWE: CWE-250
# Fix: SUID bit removed from /usr/bin/ex
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and vim (provides /usr/bin/ex)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openssh-server \
        vim \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Harden base image to ensure single vulnerability path
RUN chmod 644 /etc/crontab 2>/dev/null || true ; \
    rm -f /etc/sudoers.d/* 2>/dev/null || true

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# Ensure NO SUID bit on /usr/bin/ex or its target binary
RUN chmod u-s /usr/bin/ex && \
    chmod u-s $(readlink -f /usr/bin/ex)

# Verify vulnerability is NOT in place
RUN ! (ls -la /usr/bin/ex | grep -q "rws") && echo "No SUID bit on ex — safe"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]