FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_nc (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo rule for nc has been removed
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, sudo, and netcat (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        netcat-traditional \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify nc is installed and find its path
RUN which nc && ls -la $(which nc) && \
    ls -la /usr/bin/nc*

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: No sudo rule for nc ---
# The sudoers.d file for nc is NOT created, removing the vulnerability.

# Verify sudo configuration
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]