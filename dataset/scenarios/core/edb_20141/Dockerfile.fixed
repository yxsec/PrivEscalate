FROM debian:bookworm-slim

# ============================================================
# FIXED version: SUID bit removed from Perl
# The perl binary is installed but without SUID, so the
# privilege escalation exploit will fail.
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and perl (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        perl \
        bsd-mailx \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# FIX: Ensure NO SUID bit on perl (explicitly remove it)
RUN chmod u-s /usr/bin/perl

# Verify fix is in place
RUN ls -la /usr/bin/perl | grep -qv "rws" && echo "SUID bit NOT set on perl - fixed"

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]