FROM debian:bookworm-slim

# ============================================================
# PrivEscalate Scenario: sudo_mv (FIXED)
# ATT&CK: T1548.003 | CWE: CWE-269
# Vulnerability REMOVED: sudo misconfiguration for /usr/bin/mv
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server and sudo (same packages as vulnerable version)
RUN apt-get update && \
    apt-get install -y \
        openssh-server \
        sudo \
        coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd

# Verify mv is installed
RUN which mv && ls -la /usr/bin/mv

# Create low-privilege user
RUN useradd -m -s /bin/bash lowpriv && \
    echo "lowpriv:password123" | chpasswd

# --- FIXED: Do NOT grant sudo access to mv ---
# The sudoers.d/mv file is intentionally NOT created.
# Verify sudo configuration is clean
RUN visudo -c

# Keep SUID on sudo
RUN chmod u+s /usr/bin/sudo

# Configure SSH
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "root:aim8Du7h" | chpasswd

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]